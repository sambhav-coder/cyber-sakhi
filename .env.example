# NextAuth Configuration
NEXTAUTH_SECRET=cyber_sakhi_secure_auth_secret_jwt_2026_x7k9
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional in Local Dev / Required for Production Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Whitelisted Administrator Emails (Comma-Separated)
ADMIN_EMAILS=admin@cybersakhi.org,prashant@cybersakhi.org

# Supabase (browser / RLS-scoped)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase (server-only privileged operations). Never expose to the client.
# Required for NextAuth profile lookup, signup, and OAuth profile mapping.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key